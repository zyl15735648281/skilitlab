# ===== 数据库 =====
POSTGRES_USER=skilitlab
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=skilitlab

# ===== API（NestJS）=====
API_PORT=3001
# Docker 内通过服务名 postgres 访问；本地开发用 localhost
DATABASE_URL=postgresql://skilitlab:change-me-strong-password@localhost:5432/skilitlab?schema=public

# ===== Web（Nuxt）=====
WEB_PORT=3000
# 生产环境走 nginx 反向代理，用相对路径 /api；本地开发会由 devProxy 转发
NUXT_PUBLIC_API_BASE=/api

# ===== 站点 =====
SITE_NAME=skilitlab
SITE_URL=https://www.skilitlab.top
